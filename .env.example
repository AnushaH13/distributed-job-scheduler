# Example configuration for local development.
# Never commit .env.

APP_ENV=development
LOG_LEVEL=info
SHUTDOWN_TIMEOUT=15s

MONGO_URI=mongodb://localhost:27018
MONGO_DATABASE=job_scheduler

REDIS_ADDR=localhost:6380
REDIS_PASSWORD=
REDIS_DB=0

# Worker only: jobs run at the same time per worker process (1-256).
WORKER_CONCURRENCY=4
